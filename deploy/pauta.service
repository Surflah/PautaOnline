[Unit]
Description=PautaOnline - Camara Municipal de Itapoa (Next.js)
After=network.target

[Service]
Type=simple
User=ticamitp
WorkingDirectory=/var/www/pauta
Environment=NODE_ENV=production
Environment=PORT=3005
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
